{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MobyD",
  "version": "0.1.3",
  "identifier": "org.mobyd.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MobyD",
        "width": 1480,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#08141d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "White-whale Git client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NjAxREVCNzAzMDJCMkYKUldRdkt6Qnc2eDFnZG5vRXZPejBtYzdJdXRwbzZWcEw1dThGckpITmNSYzJnTlowMnlOVTl6NHYK",
      "endpoints": [
        "https://github.com/gyeongjin-kim/MobyD-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
